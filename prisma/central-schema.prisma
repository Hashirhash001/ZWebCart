generator client {
  provider = "prisma-client-js"
  output   = "./generated-central"
}

datasource db {
  provider = "postgresql"
  url      = env("CENTRAL_DATABASE_URL") // Central DB connection
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique // Store Google OAuth ID
  provider  String   @default("local") // "local" or "google"
  name      String?
  avatarUrl String? // Google profile picture URL
  role      Role     @default(USER)
  stores    Store[] // User's associated stores
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete field
  Log       Log[]
}

model Store {
  id        String    @id @default(uuid())
  name      String
  dbName    String    @unique
  dbUrl     String    @unique
  storeUrl  String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

model Log {
  id        Int       @id @default(autoincrement())
  level     LogLevel
  message   String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  context   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

enum Role {
  USER
  ADMIN
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}
