generator client {
  provider      = "prisma-client-js"
  output        = "./generated-store"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StoreSettings {
  id        Int      @id @default(autoincrement())
  storeId   String
  storeName String
  currency  String? // Example field for default currency
  timezone  String? // Example field for store timezone
  logoUrl   String? // Example field for store logo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
  orders    Order[]
  cart      Cart?
  wishlist  Wishlist?
  logs      Log[]
  addresses Address[]
  reviews   Review[]
}

enum Role {
  USER
  ADMIN
  VENDOR
}

model Address {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  address1   String
  address2   String?
  city       String
  state      String
  postalCode String
  country    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // Soft delete field
  Order      Order[]
}

model Category {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime? // Soft delete field
  // Relationships
  descendants CategoryHierarchy[] @relation("AncestorRelation")
  ancestors   CategoryHierarchy[] @relation("DescendantRelation")
  Product     Product[]
}

model CategoryHierarchy {
  id           Int      @id @default(autoincrement())
  ancestorId   Int
  descendantId Int
  depth        Int
  // Relationships
  ancestor     Category @relation("AncestorRelation", fields: [ancestorId], references: [id])
  descendant   Category @relation("DescendantRelation", fields: [descendantId], references: [id])

  @@unique([ancestorId, descendantId]) // Ensures no duplicate relationships
}

model Product {
  id                Int                 @id @default(autoincrement())
  name              String
  description       String?
  price             Float
  comparePrice      Float?
  categoryId        Int
  category          Category            @relation(fields: [categoryId], references: [id])
  attributes        ProductAttribute[]
  images            ProductImage[]
  stock             Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime? // Soft delete field
  orderItems        OrderItem[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  CollectionProduct CollectionProduct[]
}

model ProductAttribute {
  id        Int       @id @default(autoincrement())
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  key       String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

model ProductImage {
  id        Int       @id @default(autoincrement())
  url       String
  isPrimary Boolean   @default(false)
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

model Review {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  rating    Int       @default(1)
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  user              User        @relation(fields: [userId], references: [id])
  status            OrderStatus
  items             OrderItem[]
  totalAmount       Float
  shippingAddressId Int?
  shippingAddress   Address?    @relation(fields: [shippingAddressId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime? // Soft delete field
}

model OrderItem {
  id        Int       @id @default(autoincrement())
  orderId   Int
  order     Order     @relation(fields: [orderId], references: [id])
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime? // Soft delete field
}

model CartItem {
  id        Int       @id @default(autoincrement())
  cartId    Int
  cart      Cart      @relation(fields: [cartId], references: [id])
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime? // Soft delete field
}

model WishlistItem {
  id         Int       @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id])
  productId  Int
  product    Product   @relation(fields: [productId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // Soft delete field
}

model Collection {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  description String?
  products    CollectionProduct[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CollectionProduct {
  id           Int        @id @default(autoincrement())
  collectionId Int
  productId    Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model Theme {
  id             Int      @id @default(autoincrement())
  name           String
  currentVersion Int // Points to the active version (e.g., version 1 for default)
  templateUrl    String?
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ThemeVersion ThemeVersion[]
  pages        Page[]
}

model ThemeVersion {
  id        Int      @id @default(autoincrement())
  themeId   Int
  theme     Theme    @relation(fields: [themeId], references: [id])
  version   Int // Version number (e.g., 1 for default)
  config    Json // Snapshot of configuration
  isDefault Boolean  @default(false) // Mark the default version
  createdAt DateTime @default(now())

  @@unique([themeId, version])
}

model Page {
  id     Int    @id @default(autoincrement())
  title  String // For example, "Home", "About Us", etc.
  slug   String @unique // A URL-friendly identifier.
  config Json? // Additional page-level settings (e.g. metadata, layout options).

  // Optionally, a page may override the store’s theme.
  themeId Int?
  theme   Theme? @relation(fields: [themeId], references: [id])

  // A page is composed of one or more sections.
  sections    Section[]
  PageVersion PageVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageVersion {
  id          Int      @id @default(autoincrement())
  pageId      Int
  page        Page     @relation(fields: [pageId], references: [id])
  version     Int // Version number (e.g., 1 for first draft, 2 for an update)
  config      Json? // Snapshot of the page layout and settings
  sections    Json? // Stores a JSON snapshot of the sections and their content
  isPublished Boolean  @default(false) // Determines if this version is live
  createdAt   DateTime @default(now())

  @@unique([pageId, version]) // Ensure unique version per page
}

model Section {
  id     Int   @id @default(autoincrement())
  pageId Int?
  page   Page? @relation(fields: [pageId], references: [id])

  type  String // The type of section (for example: "hero", "featured-products", "testimonial", etc.)
  title String? // An optional title for the section.
  order Int // Used to sort the sections when rendering the page.

  isGlobal Boolean @default(false) // TRUE if this is a global section

  // JSON-based fields allow you to store any styling or content data you need.
  config  Json? // Custom styling and layout settings (e.g., fonts, colors, padding).
  content Json? // The dynamic content for the section (e.g., text, images, etc.).

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order]) // Improve query performance for section ordering
}

model Log {
  id        Int       @id @default(autoincrement())
  level     LogLevel
  message   String
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id])
  context   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete field
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  SHIPPED
  DELIVERED
  RETURNED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}
